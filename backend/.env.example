# ===== Backend IoT & AI Dashboard =====
# Salin file ini menjadi .env lalu sesuaikan nilainya

# Mode: "dev" menggunakan SQLite, "prod" menggunakan MySQL (lihat DB_URL)
APP_ENV=dev

# ----- MySQL (aktif setelah APP_ENV=prod) -----
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=password_anda
MYSQL_DB=iot_dashboard
MYSQL_CHARSET=utf8mb4

# Alias URI koneksi (boleh diisi manual; jika kosong dibangun dari MYSQL_*)
# DB_URL=mysql+pymysql://root:password@127.0.0.1:3306/iot_dashboard?charset=utf8mb4

# CORS: daftar origin frontend yang diizinkan, pisahkan dengan koma
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Kredensial login demo (hash disimpan di app/auth_routes.py untuk demo)
AUTH_USERNAME=student
AUTH_PASSWORD=student123